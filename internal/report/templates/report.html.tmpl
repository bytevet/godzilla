<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="eyebrow">Godzilla &middot; SAST</div>
    <h1>Godzilla SAST Report</h1>
    <p class="lede">Generated {{.GeneratedAt}}. Total findings: <strong>{{.Total}}</strong>{{if .Total}} &mdash; sorted worst-severity first; click any finding to expand its source, sink, and taint flow.{{end}}</p>
  </header>

  <section class="summary">
    <h2>Summary</h2>
    <div class="tiles">
      {{range .Tiles}}
      <div class="tile{{if .Lead}} lead{{end}}{{if .Class}} {{.Class}}{{end}}">
        <div class="n">{{.Count}}</div>
        <div class="l">{{.Label}}</div>
      </div>
      {{end}}
    </div>

    {{if .ByRule}}
    <h2>Findings by rule</h2>
    <div class="panel scroll">
      <table>
        <thead><tr><th>Rule</th><th>CWE</th><th class="num">Count</th></tr></thead>
        <tbody>
        {{range .ByRule}}
          <tr>
            <td><span class="klass">{{.RuleID}}</span></td>
            <td class="mono muted">{{.CWE}}</td>
            <td class="num {{.SevClass}}">{{.Count}}</td>
          </tr>
        {{end}}
        </tbody>
      </table>
    </div>
    {{end}}
  </section>

  <section class="findings">
    <h2>Details</h2>
    {{if not .Findings}}
      <p class="no-findings">No findings.</p>
    {{else}}
    <div class="controls">
      <div class="grp">
        {{range .SeverityFilter}}
        <label class="sev {{.Class}}"><input type="checkbox" data-sev="{{.Key}}" checked>{{.Label}}</label>
        {{end}}
      </div>
      <div class="grp">
        <select id="f-rule" aria-label="Filter by rule">
          <option value="">All rules</option>
          {{range .ByRule}}
          <option value="{{.RuleID}}">{{.RuleID}} ({{.Count}})</option>
          {{end}}
        </select>
      </div>
      <input id="f-search" type="search" placeholder="Search file, message, callee…" aria-label="Search findings">
      <span class="count" id="f-count">{{.Total}} / {{.Total}} shown</span>
    </div>

    {{range .Findings}}
    <details class="finding {{.SeverityClass}}{{if .Suppressed}} suppressed{{end}}" id="{{.AnchorID}}"
             data-severity="{{.SevKey}}" data-rule="{{.RuleID}}" data-cwe="{{.CWE}}" data-conf="{{.ConfKey}}">
      <summary>
        <span class="chip {{.SeverityClass}}">{{.SeverityLabel}}</span>
        <span class="klass">{{.RuleID}}</span>
        {{if .CWE}}<span class="chip cwe">{{.CWE}}</span>{{end}}
        <span class="conf {{.ConfidenceClass}}">{{.ConfidenceLabel}}</span>
        {{if .Suppressed}}<span class="chip suppressed" title="{{.SuppressionReason}}">SUPPRESSED</span>{{end}}
        <span class="msg">{{.Message}}</span>
        <span class="sink-loc">{{.SinkLocation}}</span>
      </summary>
      <div class="body">
        <div class="meta-line">
          in <code>{{.Function}}</code>{{if .Language}} &middot; <span class="muted">{{.Language}}</span>{{end}}
          &middot; sink <span class="callee">{{.SinkCallee}}</span>
          {{if .ReviewConfirmed}}<br><span class="muted">LLM review confirmed: {{.ReviewNote}}</span>{{end}}
        </div>

        <div class="subhead">Source</div>
        {{if .SourceSnippet}}
        <div class="panel">
          <div class="filehdr">{{.SourceLocation}}</div>
          {{template "snippet" .SourceSnippet}}
        </div>
        {{else}}
        <div class="snippet-missing">Source location unavailable ({{.SourceLocation}}).</div>
        {{end}}

        <div class="subhead">Sink</div>
        {{if .SinkSnippet}}
        <div class="panel">
          <div class="filehdr">{{.SinkLocation}} &rarr; {{.SinkCallee}}</div>
          {{template "snippet" .SinkSnippet}}
        </div>
        {{else}}
        <div class="snippet-missing">Sink location unavailable ({{.SinkLocation}}).</div>
        {{end}}

        {{if .HasFlow}}
        <div class="subhead">Taint spread flow</div>
        {{if .FlowEndpointsOnly}}<p class="flow-note">Endpoints only — the intermediate path crossed a function boundary and was not reconstructed.</p>{{end}}
        <div class="flow">
          {{range .Flow}}
          <details class="step">
            <summary>
              <span class="idx">{{.Index}}</span>
              {{if .Kind}}<span class="kind {{.Kind}}">{{.Kind}}</span>{{end}}
              <span class="loc">{{.Location}}</span>
            </summary>
            {{if .Snippet}}{{template "snippet" .Snippet}}{{else}}<div class="snippet-missing">Snippet unavailable.</div>{{end}}
          </details>
          {{end}}
        </div>
        {{end}}
      </div>
    </details>
    {{end}}
    {{end}}
  </section>

  <footer>Generated by Godzilla SAST.</footer>
</div>
<script>{{.JS}}</script>
</body>
</html>
{{define "snippet"}}<pre class="snippet">{{range .Lines}}<span class="line{{if .Highlight}} hl{{end}}"><span class="ln">{{.Num}}</span>{{.Text}}</span>
{{end}}</pre>{{end}}
